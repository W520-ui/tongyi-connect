APP_NAME=通译智联 API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DATABASE_URL=sqlite+aiosqlite:///data/app.db
AGENT_LLM_BASE_URL=https://api.openai.com/v1
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=gpt-4o-mini
AGENT_LLM_TIMEOUT_SECONDS=60
AGENT_LLM_TEMPERATURE=0.3
# Optional output limit; omit this setting to use the gateway default.
AGENT_LLM_MAX_TOKENS=1024
AGENT_RUN_TIMEOUT_SECONDS=60
AGENT_TOOL_TIMEOUT_SECONDS=10
AGENT_MAX_TOOL_ROUNDS=4
AGENT_CONTEXT_TOKEN_BUDGET=8192
AGENT_TOOL_RESULT_MAX_CHARS=2000
AGENT_SUMMARY_ENABLED=false
AGENT_ANALYSIS_ENABLED=true
# Omit to use AGENT_LLM_MODEL; set a model name to override.
# AGENT_ANALYSIS_MODEL=gpt-4o-mini
AGENT_ANALYSIS_TIMEOUT_SECONDS=10
